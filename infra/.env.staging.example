# =====================================================
# IntelliCare V3 — Staging Environment Template
# =====================================================
# Copiar para infra/.env.staging e preencher os valores.
# NUNCA commitar o arquivo infra/.env.staging com segredos reais.
# =====================================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<gerar: openssl rand -base64 32>
POSTGRES_DB=intellicare

# --- Aplicacao ---
SECRET_KEY=<gerar: openssl rand -hex 32>
ENVIRONMENT=staging
LOG_LEVEL=INFO
ENABLE_METRICS=true

# --- Keycloak ---
KEYCLOAK_URL=https://auth.intellicare.ia.br
KEYCLOAK_REALM=intellicare
KEYCLOAK_CLIENT_ID=intellicare-service
KEYCLOAK_CLIENT_SECRET=<gerar no Keycloak Admin Console>
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<senha forte>

# --- Kestra ---
KESTRA_URL=http://kestra:8080
KESTRA_API_KEY=<gerar no Kestra UI > Settings > API Keys>

# --- Rocket.Chat ---
ROCKETCHAT_URL=https://chat.intellicare.ia.br
ROCKETCHAT_BOT_USERNAME=intellicare-bot
ROCKETCHAT_BOT_PASSWORD=<senha forte>
ROCKETCHAT_WEBHOOK_TOKEN=<gerar no Rocket.Chat Admin > Integrations>

# --- Jitsi ---
JITSI_BASE_URL=https://meet.intellicare.ia.br
JITSI_APP_ID=intellicare
JITSI_APP_SECRET=<gerar: openssl rand -hex 32>
JICOFO_AUTH_PASSWORD=<gerar: openssl rand -hex 16>
JVB_AUTH_PASSWORD=<gerar: openssl rand -hex 16>

# --- Evolution API ---
EVOLUTION_API_KEY=<gerar: openssl rand -hex 32>
EVOLUTION_WEBHOOK_SECRET=<gerar: openssl rand -hex 32>

# --- Jasmin SMS ---
JASMIN_URL=http://jasmin:1401
JASMIN_USERNAME=admin
JASMIN_PASSWORD=<gerar: openssl rand -hex 16>
JASMIN_SENDER_ID=INTELLICARE
JASMIN_WEBHOOK_SECRET=<gerar: openssl rand -hex 32>

# --- Redis ---
REDIS_HOST=redis
REDIS_PASSWORD=<senha forte>
REDIS_PASSWORD_URLENC=<senha forte URL-encoded>

# --- Grafana ---
GRAFANA_PASSWORD=<senha forte>

# --- Traefik ---
TRAEFIK_DASHBOARD_PORT=8090
