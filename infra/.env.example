# ============================================================
# IntelliCare V3 - Variaveis de ambiente
# Copie para infra/.env e preencha os valores
# ============================================================

# PostgreSQL
POSTGRES_USER=intellicare
POSTGRES_PASSWORD=intellicare_dev_password
POSTGRES_DB=intellicare
POSTGRES_HOST=localhost

# Redis
REDIS_PASSWORD=redis_dev_password
REDIS_PASSWORD_URLENC=redis_dev_password

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://postgres:5432/keycloak
KC_DB_USERNAME=intellicare
KC_DB_PASSWORD=intellicare_dev_password
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_ON_DEPLOY
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_URL=http://localhost:8080
PORTAL_URL=http://localhost:5176
KEYCLOAK_REALM=intellicare
KEYCLOAK_CLIENT_ID=intellicare-service

# OLLAMA
OLLAMA_HOST=0.0.0.0
OLLAMA_ORIGINS=*
OLLAMA_API_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Traefik
TRAEFIK_DASHBOARD_PORT=8090

# Aplicacao
SECRET_KEY=dev-secret-key-change-in-production
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Observabilidade (Prometheus + Grafana)
ENABLE_METRICS=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_PASSWORD=CHANGE_ME_ON_DEPLOY

# Alertas Grafana (DEM-028)
GRAFANA_ALERT_EMAIL=egarabini@gmail.com
GRAFANA_SMTP_HOST=smtp.gmail.com:587
GRAFANA_SMTP_USER=alertas@intellicare.ia.br
GRAFANA_SMTP_PASSWORD=CHANGE_ME_APP_PASSWORD
GRAFANA_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
GRAFANA_SLACK_CHANNEL=#intellicare-alertas

# Criptografia de certificados digitais (Fernet)
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENCAO: rotacionar esta chave invalida certificados armazenados no banco
SERVER_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_FERNET

# Tenant de desenvolvimento
DEV_TENANT_SLUG=tenant_dev

# ─── Kestra (DEM-038) ─────────────────────────────────────────────────────────
KESTRA_URL=http://kestra:8080
KESTRA_API_KEY=
KESTRA_TIMEOUT=30.0

# ─── Rocket.Chat (DEM-038) ────────────────────────────────────────────────────
ROCKETCHAT_URL=http://rocketchat:3001
ROCKETCHAT_BOT_USERNAME=intellicare_bot
ROCKETCHAT_BOT_PASSWORD=CHANGE_ME_BOT_PASSWORD
ROCKETCHAT_WEBHOOK_TOKEN=CHANGE_ME_WEBHOOK_TOKEN_32CHARS
ROCKETCHAT_MAX_REQUESTS_PER_SECOND=10
ROCKETCHAT_MAX_RETRIES=3

# ─── Jitsi (DEM-038) ──────────────────────────────────────────────────────────
JITSI_BASE_URL=https://meet.intellicare.ia.br
JITSI_APP_ID=intellicare
JITSI_APP_SECRET=CHANGE_ME_JITSI_APP_SECRET
JITSI_DEFAULT_ROOM_DURATION=120
JITSI_MAX_PARTICIPANTS=10
JICOFO_AUTH_PASSWORD=CHANGE_ME_JICOFO_AUTH_PASSWORD
JVB_AUTH_PASSWORD=CHANGE_ME_JVB_AUTH_PASSWORD

# ─── Mongo (usado pelo Rocket.Chat) ───────────────────────────────────────────
MONGO_URL=mongodb://mongo:27017/rocketchat?replicaSet=rs0
MONGO_OPLOG_URL=mongodb://mongo:27017/local?replicaSet=rs0

# ─── Florence IA (DEM-057) ────────────────────────────────────────────────────
# Opcional — fallback rule-based se ausente
FLORENCE_LLM_URL=
FLORENCE_LLM_API_KEY=
FLORENCE_LLM_MODEL=gpt-4o-mini

# ─── Marie / Dify (DEM-075) ──────────────────────────────────────────────────
MARIE_ENABLED=false
MARIE_API_URL=http://marie-api:5001
MARIE_API_KEY=
MARIE_TIMEOUT_SECONDS=10
MARIE_DB_PASSWORD=marie-db-pass-change-me
MARIE_REDIS_PASSWORD=marie-redis-pass-change-me
MARIE_SECRET_KEY=marie-secret-change-me
