# IntelliCare V3 — normalização de line endings
# Garante LF no repositório independente do OS do dev (Windows/Linux/Mac)

* text=auto eol=lf

# Binários — nunca converter
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
*.zip  binary
*.gz   binary

# Arquivos que devem explicitamente ficar como LF
*.py        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.sql       text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.sh        text eol=lf
*.env*      text eol=lf
Dockerfile* text eol=lf
