# ============================================
# IntelliCare Core - Variaveis de Ambiente
# ============================================
# Copie para .env e ajuste os valores.
# Prefixo: INTELLICARE_

# Ambiente: development | staging | production
INTELLICARE_ENVIRONMENT=development

# Nivel de log: DEBUG | INFO | WARNING | ERROR
INTELLICARE_LOG_LEVEL=INFO

# Servidor FHIR R4
INTELLICARE_FHIR_SERVER_URL=http://localhost:8080/fhir
INTELLICARE_FHIR_TIMEOUT_SECONDS=30

# Database (cada modulo define o seu)
INTELLICARE_DATABASE_URL=postgresql://user:password@localhost:5432/intellicare

# Redis (opcional, para eventos entre modulos)
INTELLICARE_REDIS_URL=redis://localhost:6379
