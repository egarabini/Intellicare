# ============================================================================
# IntelliCare - Full Stack Environment (Fase 2.1)
# Gerado em 2026-02-24 para smoke test integrado
# ============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# Infrastructure
POSTGRES_USER=intellicare_admin
POSTGRES_PASSWORD=intellicare_dev
POSTGRES_DB=intellicare_db
REDIS_URL=redis://redis:6379/0
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Shared URLs
INTELLICARE_FHIR_SERVER_URL=http://grahame:8000/api/v1/fhir

# Module ports (External:Internal mapping)
# Backend modules (FastAPI/uvicorn)
FLORENCE_PORT=8001          # RAG + Protocolos Clínicos (8001:8000)
OSWALDO_PORT=8002           # Análise Clínica + FHIR (8002:8000)
DONABEDIAN_PORT=8003        # Qualidade + Indicadores (8003:8000)
WANDA_PORT=8004             # Orquestrador IA (8004:8000)
COMUNICACAO_PORT=8005       # WhatsApp + Email + SMS (8005:8000)
GERALDA_PORT=8006           # Gestão + Administrativo (8006:8000)
ZILDA_PORT=8007             # CNES + DATASUS (8007:8000)
MINERVA_PORT=8008           # Extração Documentos (8008:8008)
PIERRE_PORT=8009            # Scientific Search (8009:8009)
ADMIN_PORT=8010             # Administração Sistema (8010:8010)
GESTOR_PORT=8011            # Gestão Módulos Clínicos (8011:8011)
GRAHAME_PORT=8012           # FHIR R4 + CDS Hooks + Terminology (8012:8000)
NISE_PORT=8013              # Chatbot + Treinamento (8013:8000)

# Infrastructure ports
KEYCLOAK_PORT=8080          # Autenticação (8080:8080)
TRAEFIK_PORT=8888           # Reverse Proxy dashboard (8888:8080) — 8080 reservada para Keycloak
POSTGRES_PORT=5432          # Database (5432:5432)
REDIS_PORT=6379             # Cache (6379:6379)
PROMETHEUS_PORT=9090        # Métricas (9090:9090)
GRAFANA_PORT=3000           # Dashboards (3000:3000)

# Frontend
PORTAL_PORT=3001            # React + Vite Portal (3001:80)

# Portal Frontend - URLs das APIs compiladas no bundle Vite (build-time)
# IMPORTANTE: use o IP público do servidor para que o browser consiga alcançar os serviços.
# Em desenvolvimento local, remova estas linhas (os defaults localhost:800X serão usados).
VITE_API_FLORENCE_URL=http://167.86.97.142:8001
VITE_API_OSWALDO_URL=http://167.86.97.142:8002
VITE_API_DONABEDIAN_URL=http://167.86.97.142:8003
