# Keycloak (Authentication)
KEYCLOAK_PORT=8080
KEYCLOAK_HOSTNAME=keycloak.intellicare.ia.br
# URL completa usada pelo KC_HOSTNAME para corrigir NullPointerException no authority()
# Em produção, usar a URL pública: https://auth.intellicare.ia.br
# Em desenvolvimento/servidor, usar: http://IP_DO_SERVIDOR:8080
KEYCLOAK_HOSTNAME_URL=http://167.86.97.142:8080
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=intellicare
KEYCLOAK_CLIENT_ID=intellicare-client
KEYCLOAK_CLIENT_SECRET=dev-client-secret
KEYCLOAK_ISSUER=http://keycloak:8080/realms/intellicare
KEYCLOAK_AUTH_URL=http://keycloak:8080/realms/intellicare/protocol/openid-connect

# Traefik (Reverse Proxy)
TRAEFIK_PORT=8888
TRAEFIK_DASHBOARD_USERNAME=admin
TRAEFIK_DASHBOARD_PASSWORD=admin
TRAEFIK_ACME_EMAIL=admin@intellicare.ia.br
TRAEFIK_CERT_RESOLVER=letsencrypt
CF_DNS_API_TOKEN=
