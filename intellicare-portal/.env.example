# ========================================
# IntelliCare portal - Environment Variables
# ========================================

# ----------------------------------------
# Database Configuration
# ----------------------------------------
# Docker Compose (local development)
POSTGRES_DB=intellicare
POSTGRES_USER=intellicare
POSTGRES_PASSWORD=intellicare_dev
POSTGRES_PORT=5433

# Application Database URL
# Development (Docker): postgresql+asyncpg://intellicare:intellicare_dev@db:5432/intellicare
# Development (Local): postgresql+asyncpg://intellicare:intellicare_dev@localhost:5433/intellicare
# Production: postgresql+asyncpg://admin_intellicare:PASSWORD@161.97.141.186:5432/IntellicareDB
INTELLICARE_DATABASE_URL=postgresql+asyncpg://intellicare:intellicare_dev@localhost:5433/intellicare

# Database Schema (isolamento por módulo)
DATABASE_SCHEMA=intellicare_portal

# ----------------------------------------
# API Configuration
# ----------------------------------------
API_HOST=0.0.0.0
API_PORT=8003
API_RELOAD=false
API_WORKERS=4

# ----------------------------------------
# Dashboard Configuration
# ----------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8501
DASHBOARD_API_URL=http://localhost:8003/api/v1

# ----------------------------------------
# Module Information
# ----------------------------------------
MODULE_NAME=intellicare-portal
MODULE_VERSION=1.0.0
MODULE_DESCRIPTION=Módulo de avaliação de qualidade assistencial baseado no framework de portal

# ----------------------------------------
# Environment
# ----------------------------------------
# Options: development, staging, production
ENVIRONMENT=development

# ----------------------------------------
# Logging
# ----------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ----------------------------------------
# CORS (separado por vírgula)
# ----------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8501,http://localhost:8503

# ----------------------------------------
# Security (para versões futuras)
# ----------------------------------------
SECRET_KEY=your-secret-key-here-change-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# ----------------------------------------
# Redis Configuration (FASE 2.2/2.3 - Event Publishing & Consolidation)
# ----------------------------------------
# Development: redis://localhost:6379
# Docker Compose: redis://redis:6379
# Production: redis://user:password@redis.host:6379
REDIS_URL=redis://localhost:6379

# ----------------------------------------
# Keycloak Configuration (FASE 2.1 - Authentication)
# ----------------------------------------
KEYCLOAK_SERVER_URL=http://keycloak.local:8080
KEYCLOAK_REALM=bemcuidar
KEYCLOAK_CLIENT_ID=intellicare-portal
KEYCLOAK_CLIENT_SECRET=DKFaLrOoVrmUzsRFN6941x2LVyzjv4Cs
KEYCLOAK_DIRECT_ACCESS_GRANT_ENABLED=true

# ----------------------------------------
# Consolidation Consumer Configuration (FASE 2.3)
# ----------------------------------------
# Consumer ID for Redis Streams consumer group
CONSUMER_ID=portal-consolidation-worker-1

# Events per batch read from Redis
CONSUMER_BATCH_SIZE=100

# Timeout for XREADGROUP block (milliseconds)
CONSUMER_BLOCK_TIMEOUT=5000

# ----------------------------------------
# Database URL for Consolidation (FASE 2.3)
# ----------------------------------------
# Override INTELLICARE_DATABASE_URL if needed for consolidation-specific connection
CONSOLIDATION_DATABASE_URL=

# ----------------------------------------
# Testing Configuration
# ----------------------------------------
PYTEST_ASYNCIO_MODE=auto
TEST_DATABASE_URL=postgresql+asyncpg://intellicare:intellicare_dev@localhost:5433/intellicare_test


