# ============================================================================
# IntelliCare Portal - Frontend Environment Variables
# ============================================================================
# Copie este arquivo para .env.local para desenvolvimento local
# As variáveis VITE_* são injetadas no build do Vite
# ============================================================================

# ============================================================================
# BACKEND MODULE URLs
# ============================================================================
# Florence - RAG + Protocolos Clínicos (8001)
VITE_API_FLORENCE_URL=http://localhost:8001

# Oswaldo - Análise Clínica + FHIR (8002)
VITE_API_OSWALDO_URL=http://localhost:8002

# Donabedian - Qualidade + Indicadores (8003)
VITE_API_DONABEDIAN_URL=http://localhost:8003

# Wanda - Orquestração + Workflows (8004)
VITE_API_WANDA_URL=http://localhost:8004

# Comunicacao - Comunicação + Notificações (8005)
VITE_API_COMUNICACAO_URL=http://localhost:8005

# Geralda - Gestão + Administrativo (8006)
VITE_API_GERALDA_URL=http://localhost:8006

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Timeout para requisições HTTP (em milissegundos)
VITE_API_TIMEOUT=30000

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================
# Habilitar analytics (Google Analytics, Mixpanel, etc.)
VITE_ENABLE_ANALYTICS=false

# ============================================================================
# APPLICATION INFO
# ============================================================================
# Versão da aplicação (exibida no footer/about)
VITE_APP_VERSION=0.1.0-demo

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================
# Habilitar modo debug (logs verbosos no console)
VITE_DEBUG_MODE=false

# Habilitar mock de dados (para desenvolvimento sem backend)
VITE_ENABLE_MOCKS=false
