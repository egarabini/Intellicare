VITE_APP_VERSION=0.1.0-staging

# ============================================================================
# SHARED SERVICES - FHIR Server
# ============================================================================
INTELLICARE_FHIR_SERVER_URL=http://fhir-server:8080/fhir
INTELLICARE_FHIR_TIMEOUT_SECONDS=30

# ============================================================================
# AUTHENTICATION - Keycloak (Optional - Future)
# ============================================================================
KEYCLOAK_ENABLED=false
KEYCLOAK_SERVER_URL=https://keycloak.intellicare.staging/
KEYCLOAK_REALM=intellicare
KEYCLOAK_CLIENT_ID=intellicare-portal
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_KEYCLOAK_SECRET
KEYCLOAK_JWKS_CACHE_TTL=300
KEYCLOAK_TOKEN_CACHE_TTL=60
KEYCLOAK_VERIFY_SSL=true
KEYCLOAK_VALIDATE_AUDIENCE=true
KEYCLOAK_VALIDATE_ISSUER=true

# ============================================================================
# OPTIONAL MODULES - Nise (AI/LLM)
# ============================================================================
NISE_ENABLED=false
NISE_PORT=8008
NISE_DATABASE_URL=postgresql://intellicare_admin:CHANGE_ME_POSTGRES_STRONG_PASSWORD@postgres:5432/intellicare_db
NISE_REDIS_URL=redis://:CHANGE_ME_REDIS_STRONG_PASSWORD@redis:6379/0
NISE_REDIS_TTL=300

# Flowise Integration
FLOWISE_URL=http://flowise:3000
FLOWISE_API_KEY=
FLOWISE_PASSWORD=CHANGE_ME_FLOWISE_PASSWORD

# Ollama Integration
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama2:7b

# ============================================================================
# OPTIONAL MODULES - Superz (Web Search)
# ============================================================================
SUPERZ_ENABLED=false
SUPERZ_PORT=8009
SUPERZ_WORKERS=4

# Tavily Web Search (Required for web_search tool)
TAVILY_API_KEY=

# NCBI PubMed (Optional - improves rate limit)
NCBI_API_KEY=

# Superz LLM
SUPERZ_LLM_MODEL=qwen2.5:72b
SUPERZ_LLM_MODEL_FALLBACK=qwen2.5:7b
SUPERZ_TAVILY_RATE_LIMIT_PER_HOUR=100

# Knowledge Integration
SUPERZ_ENABLE_KNOWLEDGE_INTEGRATION=false
SUPERZ_KNOWLEDGE_BASE_URL=http://localhost:8010
SUPERZ_KNOWLEDGE_TIMEOUT_SECONDS=3.0

# ============================================================================
# CORE CONFIGURATION
# ============================================================================
INTELLICARE_ENVIRONMENT=staging
INTELLICARE_LOG_LEVEL=INFO
INTELLICARE_MODULE_NAME=intellicare
INTELLICARE_MODULE_VERSION=0.1.0-staging
