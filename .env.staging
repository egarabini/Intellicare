EMAIL_FROM_NAME=IntelliCare - Staging
EMAIL_REPLY_TO=noreply@intellicare.com.br
EMAIL_TEMPLATE_DIR=comunicacao/templates/email

# ============================================================================
# BACKEND SERVICES - Geralda (8006)
# ============================================================================
GERALDA_PORT=8006
INTELLICARE_GERALDA_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_POSTGRES_STRONG_PASSWORD@postgres:5432/intellicare_db
GERALDA_DATABASE_SCHEMA=intellicare_geralda

# ============================================================================
# FRONTEND - Portal (3001)
# ============================================================================
PORTAL_PORT=3001
VITE_API_FLORENCE_URL=http://167.86.97.142:8001
VITE_API_OSWALDO_URL=http://167.86.97.142:8002
VITE_API_DONABEDIAN_URL=http://167.86.97.142:8003
VITE_API_WANDA_URL=http://167.86.97.142:8004
VITE_API_COMUNICACAO_URL=http://167.86.97.142:8005
VITE_API_GERALDA_URL=http://167.86.97.142:8006
VITE_API_TIMEOUT=30000
