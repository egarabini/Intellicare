# ============================================================================
# IntelliCare - Servidor de STAGING (Padrão V2)
# ============================================================================
# SERVER 05 - INTELLICARE (Contabo)
# IP: 167.86.97.142
# vCPU: 12 Cores | RAM: 48 GB | Disco: 250 GB NVMe | Porta: 800Mbit/s
# ============================================================================
# ⚠️  AVISO DE SEGURANÇA ⚠️
# - Este arquivo contém PLACEHOLDERS, não credenciais reais
# - Substitua os valores CHANGE_ME_* por senhas fortes antes do uso
# - Armazene credenciais reais em cofre/secret manager, NÃO no Git
# - Para compatibilidade temporária, este arquivo pode ser copiado de .env.homologacao
#   MAS as credenciais devem ser rotacionadas imediatamente
# ============================================================================

# ============================================================================
# INFRASTRUCTURE - PostgreSQL
# ============================================================================
POSTGRES_USER=intellicare_admin
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_STRONG_PASSWORD
POSTGRES_DB=intellicare_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================================================
# INFRASTRUCTURE - Redis
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_STRONG_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_STRONG_PASSWORD@redis:6379

# ============================================================================
# INFRASTRUCTURE - Monitoring
# ============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_STRONG_PASSWORD

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
ENVIRONMENT=staging
LOG_LEVEL=INFO
DOMAIN=167.86.97.142
SERVER_IP=167.86.97.142

# ============================================================================
# BACKEND SERVICES - Florence (8001)
# ============================================================================
FLORENCE_PORT=8001
FLORENCE_API_PORT=8001
INTELLICARE_FLORENCE_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_POSTGRES_STRONG_PASSWORD@postgres:5432/intellicare_db
FLORENCE_DATABASE_SCHEMA=intellicare_florence

# Florence Features
INTELLICARE_ENABLE_RAG=true
INTELLICARE_ENABLE_DIAGNOSTIC_SUPPORT=true
INTELLICARE_TREND_MIN_DATA_POINTS=3
INTELLICARE_TREND_DEFAULT_PERIOD_DAYS=180

# ============================================================================
# BACKEND SERVICES - Oswaldo (8002)
# ============================================================================
OSWALDO_PORT=8002
INTELLICARE_OSWALDO_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_POSTGRES_STRONG_PASSWORD@postgres:5432/intellicare_db
OSWALDO_DATABASE_SCHEMA=intellicare_oswaldo

# Oswaldo Features
INTELLICARE_ENABLE_MEDICATION_ADVISOR=false
INTELLICARE_ENABLE_CV_RISK_CALCULATOR=false

# ============================================================================
# BACKEND SERVICES - Donabedian (8003)
# ============================================================================
DONABEDIAN_PORT=8003
INTELLICARE_DONABEDIAN_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_POSTGRES_STRONG_PASSWORD@postgres:5432/intellicare_db
DONABEDIAN_DATABASE_SCHEMA=intellicare_donabedian

# API Configuration
API_HOST=0.0.0.0
API_PORT=8003
API_RELOAD=false
API_WORKERS=8

# ============================================================================
# BACKEND SERVICES - Wanda (8004)
# ============================================================================
WANDA_PORT=8004
INTELLICARE_WANDA_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_POSTGRES_STRONG_PASSWORD@postgres:5432/intellicare_db
WANDA_DATABASE_SCHEMA=intellicare_wanda

# Module URLs for Discovery
INTELLICARE_OSWALDO_URL=http://oswaldo:8002
INTELLICARE_FLORENCE_URL=http://florence:8001
INTELLICARE_ZILDA_URL=http://zilda:8007
INTELLICARE_DONABEDIAN_URL=http://donabedian:8003
INTELLICARE_COMUNICACAO_URL=http://comunicacao:8005
INTELLICARE_GERALDA_URL=http://geralda:8006

# Discovery Settings
INTELLICARE_DISCOVERY_TIMEOUT_SECONDS=5
INTELLICARE_HEALTH_CHECK_INTERVAL_SECONDS=30

# Orchestration
INTELLICARE_MAX_MODULES_PER_QUERY=3
INTELLICARE_MODULE_CALL_TIMEOUT_SECONDS=30

# Safety
INTELLICARE_ENABLE_IPS_FIRST=true
INTELLICARE_ENABLE_SAFETY_GUARDRAILS=true

# ============================================================================
# BACKEND SERVICES - Comunicacao (8005)
# ============================================================================
COMUNICACAO_PORT=8005
INTELLICARE_COMUNICACAO_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_POSTGRES_STRONG_PASSWORD@postgres:5432/intellicare_db
COMUNICACAO_DATABASE_SCHEMA=intellicare_comunicacao

# Matrix/Synapse (Legacy - Descontinuado)
INTELLICARE_MATRIX_HOMESERVER_URL=http://localhost:8008
INTELLICARE_MATRIX_USERNAME=@intellicare_bot:localhost
INTELLICARE_MATRIX_PASSWORD=DISABLED_LEGACY

