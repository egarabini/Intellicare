# ============================================================
# IntelliCare V3 — .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/
*.egg
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.log

# Node / Frontend
node_modules/
**/package-lock.json
dist/
.next/
.nuxt/
.cache/
*.local

# Environment & Secrets
.env
.env.*
!.env.example
infra/.env.staging
*.pem
*.key
keycloak_client_secrets.json
secrets/

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Docker
*.override.yml

# Alembic
alembic/versions/*.pyc

# Generated docs
docs/generated/*.md
!docs/generated/.gitkeep

# Worktrees
.worktrees/

# Arquivos Pessoais e Rascunhos
estudos/

# Build artifacts / logs (não versionar)
frontend/**/*.txt
tests/e2e/report/
docker_build.txt
pytest_errors.txt
pytest_output.txt
pytest_log.txt
packages/intellicare-core/pytest_output.txt
test-results/

# Arquivos de debug / smoke test (raiz do repo — nunca commitar)
token.json
swagger.yml
trigger.py
put_kv.py
*_logs.txt
*_logs2.txt

# Let's Encrypt — nunca commitar (contém chaves privadas dos certificados)
infra/letsencrypt/
