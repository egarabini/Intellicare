# ============================================================================
# IntelliCare - Environment Configuration Template
# ============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.full
# 2. Substitua todos os valores PLACEHOLDER com valores reais
# 3. NÃO commit o arquivo .env.full com valores reais de produção
# ============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================================
# Infrastructure - Database
# ============================================================================
POSTGRES_USER=intellicare_admin
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=intellicare_db
POSTGRES_PORT=5432

# ============================================================================
# Infrastructure - Cache
# ============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ============================================================================
# Infrastructure - Monitoring
# ============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ============================================================================
# Shared URLs
# ============================================================================
INTELLICARE_FHIR_SERVER_URL=http://grahame:8000/api/v1/fhir

# ============================================================================
# Module ports (External:Internal mapping)
# ============================================================================
# Backend modules (FastAPI/uvicorn)
FLORENCE_PORT=8001          # RAG + Protocolos Clínicos (8001:8000)
OSWALDO_PORT=8002           # Análise Clínica + FHIR (8002:8000)
DONABEDIAN_PORT=8003        # Qualidade + Indicadores (8003:8000)
WANDA_PORT=8004             # Orquestrador IA (8004:8000)
COMUNICACAO_PORT=8005       # WhatsApp + Email + SMS (8005:8000)
GERALDA_PORT=8006           # Gestão + Administrativo (8006:8000)
ZILDA_PORT=8007             # CNES + DATASUS (8007:8000)
MINERVA_PORT=8008           # Extração Documentos (8008:8008)
PIERRE_PORT=8009            # Scientific Search (8009:8009)
ADMIN_PORT=8010             # Administração Sistema (8010:8010)
GESTOR_PORT=8011            # Gestão Módulos Clínicos (8011:8011)
GRAHAME_PORT=8012           # FHIR R4 + CDS Hooks + Terminology (8012:8000)
NISE_PORT=8013              # Chatbot + Treinamento (8013:8000)

# Infrastructure ports
KEYCLOAK_PORT=8080          # Autenticação (8080:8080)
TRAEFIK_PORT=8080           # Reverse Proxy (8080:80)

# Frontend
PORTAL_PORT=3001            # React + Vite Portal (3001:80)

# ============================================================================
# Database URLs per module
# ============================================================================
INTELLICARE_FLORENCE_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_SECURE_PASSWORD@postgres:5432/intellicare_db
INTELLICARE_OSWALDO_DATABASE_URL=postgresql+psycopg://intellicare_admin:CHANGE_ME_SECURE_PASSWORD@postgres:5432/intellicare_db
INTELLICARE_DONABEDIAN_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_SECURE_PASSWORD@postgres:5432/intellicare_db
INTELLICARE_WANDA_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_SECURE_PASSWORD@postgres:5432/intellicare_db
INTELLICARE_COMUNICACAO_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_SECURE_PASSWORD@postgres:5432/intellicare_db
INTELLICARE_GERALDA_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_SECURE_PASSWORD@postgres:5432/intellicare_db
INTELLICARE_ZILDA_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_SECURE_PASSWORD@postgres:5432/intellicare_db
INTELLICARE_GRAHAME_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_SECURE_PASSWORD@postgres:5432/intellicare_db
INTELLICARE_MINERVA_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_SECURE_PASSWORD@postgres:5432/intellicare_db
INTELLICARE_PIERRE_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_SECURE_PASSWORD@postgres:5432/intellicare_db
INTELLICARE_NISE_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_SECURE_PASSWORD@postgres:5432/intellicare_db
DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_SECURE_PASSWORD@postgres:5432/intellicare_db

# ============================================================================
# Service URLs (inter-module communication)
# ============================================================================
INTELLICARE_FLORENCE_URL=http://florence:8000
INTELLICARE_OSWALDO_URL=http://oswaldo:8000
INTELLICARE_DONABEDIAN_URL=http://donabedian:8000
INTELLICARE_WANDA_URL=http://wanda:8000
INTELLICARE_COMUNICACAO_URL=http://comunicacao:8000
INTELLICARE_GERALDA_URL=http://geralda:8000
INTELLICARE_ZILDA_URL=http://zilda:8000
INTELLICARE_GRAHAME_URL=http://grahame:8000
INTELLICARE_MINERVA_URL=http://minerva:8008
INTELLICARE_PIERRE_URL=http://pierre:8009
INTELLICARE_NISE_URL=http://nise:8000
INTELLICARE_KEYCLOAK_URL=http://keycloak:8080

# ============================================================================
# Orchestration tuning
# ============================================================================
INTELLICARE_DISCOVERY_TIMEOUT_SECONDS=5
INTELLICARE_MAX_MODULES_PER_QUERY=3

# ============================================================================
# Comunicacao - external dependencies
# ============================================================================
ROCKETCHAT_URL=http://rocketchat:3000
ROCKETCHAT_ADMIN_USERNAME=admin
ROCKETCHAT_ADMIN_PASSWORD=CHANGE_ME_ROCKETCHAT_PASSWORD
JITSI_DOMAIN=meet.jitsi
JITSI_URL=https://meet.jitsi
JITSI_APP_ID=intellicare
JITSI_APP_SECRET=CHANGE_ME_JITSI_SECRET
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_WHATSAPP_TOKEN
WAHA_BASE_URL=http://waha:3000
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_TIMEOUT_SECONDS=30
TWILIO_ACCOUNT_SID=CHANGE_ME_TWILIO_SID
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_TOKEN
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=intellicare@example.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD

# ============================================================================
# AI/search integrations
# ============================================================================
OLLAMA_URL=http://ollama:11434
TAVILY_API_KEY=CHANGE_ME_TAVILY_KEY
NCBI_API_KEY=
FLOWISE_API_KEY=
LLAMAPARSE_API_KEY=

# ============================================================================
# Keycloak (Authentication)
# ============================================================================
KEYCLOAK_PORT=8080
KEYCLOAK_HOSTNAME=keycloak.intellicare.ia.br
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD
KEYCLOAK_REALM=intellicare
KEYCLOAK_CLIENT_ID=intellicare-client
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_KEYCLOAK_CLIENT_SECRET
KEYCLOAK_ISSUER=http://keycloak:8080/realms/intellicare
KEYCLOAK_AUTH_URL=http://keycloak:8080/realms/intellicare/protocol/openid-connect

# ============================================================================
# Traefik (Reverse Proxy)
# ============================================================================
TRAEFIK_PORT=8080
TRAEFIK_DASHBOARD_USERNAME=admin
TRAEFIK_DASHBOARD_PASSWORD=CHANGE_ME_TRAEFIK_PASSWORD
TRAEFIK_ACME_EMAIL=admin@intellicare.ia.br
TRAEFIK_CERT_RESOLVER=letsencrypt
CF_DNS_API_TOKEN=CHANGE_ME_CLOUDFLARE_TOKEN
