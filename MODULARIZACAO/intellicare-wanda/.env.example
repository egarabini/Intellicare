# ──────────────────────────────────────────────────────────────
# WANDA v2.1 — Variáveis de Ambiente (copiar para .env)
# ──────────────────────────────────────────────────────────────

# ── Módulo ─────────────────────────────────────────────────────
INTELLICARE_MODULE_NAME=intellicare-wanda
INTELLICARE_MODULE_VERSION=2.0.0
WANDA_PORT=8007

# ── Agentes HTTP ────────────────────────────────────────────────
# Em desenvolvimento local: usar localhost com porta do módulo
# Em Docker Compose: usar nome do serviço (oswaldo, florence, etc.)
INTELLICARE_OSWALDO_URL=http://localhost:8001
INTELLICARE_FLORENCE_URL=http://localhost:8002
INTELLICARE_ZILDA_URL=http://localhost:8003
INTELLICARE_DONABEDIAN_URL=http://localhost:8004
INTELLICARE_COMUNICACAO_URL=http://localhost:8005
INTELLICARE_GERALDA_URL=http://localhost:8006

# ── EF-W001: PostgreSQL ─────────────────────────────────────────
# Docker Compose: postgresql+asyncpg://wanda:wanda@db:5432/intellicare
# Local: postgresql+asyncpg://wanda:wanda@localhost:5432/intellicare
INTELLICARE_DATABASE_URL=postgresql+asyncpg://wanda:wanda@localhost:5432/intellicare
INTELLICARE_DATABASE_SCHEMA=wanda
INTELLICARE_ENABLE_PERSISTENCE=true

# ── EF-W002: Redis / Cache IPS ──────────────────────────────────
# Docker Compose: redis://redis:6379/0
# Local: redis://localhost:6379/0
INTELLICARE_REDIS_URL=redis://localhost:6379/0
INTELLICARE_ENABLE_REDIS=true
INTELLICARE_IPS_TTL_SECONDS=3600
INTELLICARE_IPS_STALE_TTL_SECONDS=86400

# ── EF-W011: MCP Servers ────────────────────────────────────────
# MINERVA (OCR/MINERVA) — porta 8008 — habilitar quando V5.0.1 estiver disponível
INTELLICARE_MCP_OCR_URL=http://localhost:8008
# PIERRE (SuperZ) — porta 8009 — habilitar quando V5.0.1 estiver disponível
INTELLICARE_MCP_SUPERZ_URL=http://localhost:8009
INTELLICARE_ENABLE_MCP=false

# ── EF-W003: Ollama / LLM Routing ──────────────────────────────
# Habilitar somente se Ollama estiver rodando localmente
# Por padrão: false — usa roteamento por keyword (v1.0)
INTELLICARE_ENABLE_OLLAMA=false
INTELLICARE_OLLAMA_URL=http://localhost:11434
INTELLICARE_OLLAMA_ROUTING_MODEL=llama3.1:8b
INTELLICARE_OLLAMA_ROUTING_TIMEOUT_SECONDS=5

# EF-W003: Estratégia de roteamento
# auto → usa LLM se disponível, keyword como fallback
# llm  → força LLM (falha se indisponível)
# keyword → força roteamento por keyword
INTELLICARE_ROUTING_METHOD=auto
INTELLICARE_LLM_CONFIDENCE_MIN=0.7

# ── EF-W004: Aggregação Inteligente ─────────────────────────────
INTELLICARE_OLLAMA_AGGREGATION_MODEL=llama3.1:8b
INTELLICARE_OLLAMA_AGGREGATION_TIMEOUT_SECONDS=15
INTELLICARE_MAX_AGENTS_FOR_LLM_AGGREGATION=5

# ── Safety ──────────────────────────────────────────────────────
INTELLICARE_ENABLE_IPS_FIRST=true
INTELLICARE_ENABLE_SAFETY_GUARDRAILS=true

# ── Discovery ────────────────────────────────────────────────────
INTELLICARE_DISCOVERY_TIMEOUT_SECONDS=5
INTELLICARE_HEALTH_CHECK_INTERVAL_SECONDS=30
INTELLICARE_MAX_MODULES_PER_QUERY=3
INTELLICARE_MODULE_CALL_TIMEOUT_SECONDS=30

# ── Ambiente ─────────────────────────────────────────────────────
INTELLICARE_ENVIRONMENT=development
INTELLICARE_LOG_LEVEL=INFO

# ── FHIR (herdado do core) ───────────────────────────────────────
INTELLICARE_FHIR_SERVER_URL=http://localhost:8080/fhir

# ──────────────────────────────────────────────────────────────
# WANDA v3.0 — Fase 3 (EF-W005 a W013)
# ──────────────────────────────────────────────────────────────

# ── EF-W005: LangGraph Workflows ────────────────────────────────
# Habilita workflows multi-agente com LangGraph real
INTELLICARE_ENABLE_LANGGRAPH=false
INTELLICARE_WORKFLOW_MAX_ITERATIONS=3
INTELLICARE_WORKFLOW_TIMEOUT_SECONDS=60
INTELLICARE_WORKFLOW_PARALLEL_TIMEOUT_SECONDS=30

# ── EF-W006: Event Consumer (Redis Streams XREADGROUP) ──────────
INTELLICARE_ENABLE_EVENT_CONSUMER=false
INTELLICARE_EVENT_CONSUMER_GROUP=wanda
INTELLICARE_EVENT_CONSUMER_NAME=wanda-orchestrator

# ── EF-W007: AlertHub Clínico ────────────────────────────────────
INTELLICARE_ENABLE_ALERT_HUB=false
INTELLICARE_ALERT_CONSOLIDATION_WINDOW_SECONDS=300
INTELLICARE_ALERT_ESCALATION_CHECK_INTERVAL_SECONDS=60

# ── EF-W012: Bot @intellicare Rocket.Chat ────────────────────────
INTELLICARE_ENABLE_RC_BOT=false
# URL do servidor Rocket.Chat
INTELLICARE_ROCKETCHAT_URL=https://rocket.gsi.srv.br
# Token do bot (Personal Access Token gerado no RC)
INTELLICARE_ROCKETCHAT_BOT_TOKEN=
# User-Id do bot no RC
INTELLICARE_ROCKETCHAT_BOT_USER_ID=
# Token do webhook (para validar chamadas do RC → WANDA)
INTELLICARE_ROCKETCHAT_WEBHOOK_TOKEN=
# Keycloak para autorização de comandos
INTELLICARE_KEYCLOAK_URL=https://keycloak.gsi.srv.br
INTELLICARE_KEYCLOAK_REALM=bemcuidar
# TTL do contexto de conversa por usuário (segundos)
INTELLICARE_BOT_CONTEXT_TTL_SECONDS=1800

# ── EF-W013: Dr. Nise / FLOWISE ──────────────────────────────────
INTELLICARE_ENABLE_DR_NISE=false
# URL do servidor FLOWISE (interno Docker Compose)
INTELLICARE_FLOWISE_URL=http://flowise:3001
# ID do chatflow Dr. Nise no FLOWISE
INTELLICARE_FLOWISE_DR_NISE_FLOW_ID=
# API Key do FLOWISE (se habilitada)
INTELLICARE_FLOWISE_API_KEY=
# Timeout para chamadas ao FLOWISE (segundos)
INTELLICARE_FLOWISE_TIMEOUT_SECONDS=30
# TTL da sessão de chat do paciente (segundos)
INTELLICARE_NISE_SESSION_TTL_SECONDS=7200
# Máximo de mensagens no histórico enviado ao FLOWISE
INTELLICARE_NISE_MAX_HISTORY_MESSAGES=20
# Habilita escalação automática ao AlertHub (emergências detectadas)
INTELLICARE_NISE_ESCALATION_ENABLED=true
