# ============================================================================
# IntelliCare - Variáveis de Ambiente para Deploy
# ============================================================================
# Copie este arquivo para .env e ajuste os valores para seu ambiente.
# IMPORTANTE: Nunca versione o arquivo .env com credenciais reais!
# ============================================================================

# ============================================================================
# INFRASTRUCTURE - PostgreSQL
# ============================================================================
POSTGRES_USER=intellicare_admin
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=intellicare_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================================================
# INFRASTRUCTURE - Redis
# ============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# ============================================================================
# INFRASTRUCTURE - Monitoring
# ============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ============================================================================
# DEPLOYMENT CONFIGURATION
# ============================================================================
ENVIRONMENT=staging
LOG_LEVEL=INFO
DOMAIN=staging.intellicare.com.br

# ============================================================================
# BACKEND SERVICES - Florence (8001)
# ============================================================================
FLORENCE_PORT=8001
FLORENCE_API_PORT=8001
INTELLICARE_FLORENCE_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_IN_PRODUCTION@postgres:5432/intellicare_db
FLORENCE_DATABASE_SCHEMA=intellicare_florence

# Florence Features
INTELLICARE_ENABLE_RAG=true
INTELLICARE_ENABLE_DIAGNOSTIC_SUPPORT=true
INTELLICARE_TREND_MIN_DATA_POINTS=3
INTELLICARE_TREND_DEFAULT_PERIOD_DAYS=180

# ============================================================================
# BACKEND SERVICES - Oswaldo (8002)
# ============================================================================
OSWALDO_PORT=8002
INTELLICARE_OSWALDO_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_IN_PRODUCTION@postgres:5432/intellicare_db
OSWALDO_DATABASE_SCHEMA=intellicare_oswaldo

# Oswaldo Features
INTELLICARE_ENABLE_MEDICATION_ADVISOR=false
INTELLICARE_ENABLE_CV_RISK_CALCULATOR=false

# ============================================================================
# BACKEND SERVICES - Donabedian (8003)
# ============================================================================
DONABEDIAN_PORT=8003
INTELLICARE_DONABEDIAN_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_IN_PRODUCTION@postgres:5432/intellicare_db
DONABEDIAN_DATABASE_SCHEMA=intellicare_donabedian

# API Configuration
API_HOST=0.0.0.0
API_PORT=8003
API_RELOAD=false
API_WORKERS=4

# ============================================================================
# BACKEND SERVICES - Wanda (8004)
# ============================================================================
WANDA_PORT=8004
INTELLICARE_WANDA_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_IN_PRODUCTION@postgres:5432/intellicare_db
WANDA_DATABASE_SCHEMA=intellicare_wanda

# Module URLs for Discovery
INTELLICARE_OSWALDO_URL=http://oswaldo:8002
INTELLICARE_FLORENCE_URL=http://florence:8001
INTELLICARE_ZILDA_URL=http://zilda:8007
INTELLICARE_DONABEDIAN_URL=http://donabedian:8003
INTELLICARE_COMUNICACAO_URL=http://comunicacao:8005
INTELLICARE_GERALDA_URL=http://geralda:8006

# Discovery Settings
INTELLICARE_DISCOVERY_TIMEOUT_SECONDS=5
INTELLICARE_HEALTH_CHECK_INTERVAL_SECONDS=30

# Orchestration
INTELLICARE_MAX_MODULES_PER_QUERY=3
INTELLICARE_MODULE_CALL_TIMEOUT_SECONDS=30

# Safety
INTELLICARE_ENABLE_IPS_FIRST=true
INTELLICARE_ENABLE_SAFETY_GUARDRAILS=true

# ============================================================================
# BACKEND SERVICES - Comunicacao (8005)
# ============================================================================
COMUNICACAO_PORT=8005
INTELLICARE_COMUNICACAO_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_IN_PRODUCTION@postgres:5432/intellicare_db
COMUNICACAO_DATABASE_SCHEMA=intellicare_comunicacao

# Matrix/Synapse (Legacy - Descontinuado)
INTELLICARE_MATRIX_HOMESERVER_URL=http://localhost:8008
INTELLICARE_MATRIX_USERNAME=@intellicare_bot:localhost
INTELLICARE_MATRIX_PASSWORD=CHANGE_ME

# Rocket.Chat (V5 Oficial)
ROCKETCHAT_URL=http://rocketchat:3000
ROCKETCHAT_ADMIN_USERNAME=admin
ROCKETCHAT_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION
ROCKETCHAT_BOT_USERNAME=intellicare
ROCKETCHAT_BOT_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Jitsi Meet (Teleconsultas)
JITSI_DOMAIN=meet.jitsi
JITSI_URL=https://meet.jitsi
JITSI_APP_ID=intellicare
JITSI_APP_SECRET=CHANGE_ME_IN_PRODUCTION

# External Channels - Push Notifications
PUSH_ENABLED=true
VAPID_PRIVATE_KEY=CHANGE_ME_IN_PRODUCTION
VAPID_PUBLIC_KEY=CHANGE_ME_IN_PRODUCTION
VAPID_SUBJECT=mailto:intellicare@example.com

# External Channels - FCM (Firebase Cloud Messaging)
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_KEY=

# External Channels - WhatsApp Business API
WHATSAPP_ENABLED=true
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_IN_PRODUCTION
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME
WHATSAPP_VERIFY_TOKEN=CHANGE_ME_IN_PRODUCTION

# External Channels - SMS
SMS_ENABLED=true
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME_IN_PRODUCTION
TWILIO_PHONE_NUMBER=+5511999999999

# External Channels - Email (SMTP)
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=intellicare@example.com
SMTP_PASSWORD=CHANGE_ME_IN_PRODUCTION
EMAIL_FROM=intellicare@example.com
EMAIL_FROM_NAME=IntelliCare - Plataforma de Saúde
EMAIL_REPLY_TO=noreply@example.com
EMAIL_TEMPLATE_DIR=comunicacao/templates/email

# ============================================================================
# BACKEND SERVICES - Geralda (8006)
# ============================================================================
GERALDA_PORT=8006
INTELLICARE_GERALDA_DATABASE_URL=postgresql+asyncpg://intellicare_admin:CHANGE_ME_IN_PRODUCTION@postgres:5432/intellicare_db
GERALDA_DATABASE_SCHEMA=intellicare_geralda

# ============================================================================
# FRONTEND - Portal (3001)
# ============================================================================
PORTAL_PORT=3001
VITE_API_FLORENCE_URL=http://localhost:8001
VITE_API_OSWALDO_URL=http://localhost:8002
VITE_API_DONABEDIAN_URL=http://localhost:8003
VITE_API_WANDA_URL=http://localhost:8004
VITE_API_COMUNICACAO_URL=http://localhost:8005
VITE_API_GERALDA_URL=http://localhost:8006
VITE_API_TIMEOUT=30000
VITE_ENABLE_ANALYTICS=false
VITE_APP_VERSION=0.1.0-demo

# ============================================================================
# SHARED SERVICES - FHIR Server
# ============================================================================
INTELLICARE_FHIR_SERVER_URL=http://localhost:8080/fhir
INTELLICARE_FHIR_TIMEOUT_SECONDS=30

# ============================================================================
# AUTHENTICATION - Keycloak (Optional - Future)
# ============================================================================
KEYCLOAK_ENABLED=false
KEYCLOAK_SERVER_URL=https://keycloak.example.com/
KEYCLOAK_REALM=bemcuidar
KEYCLOAK_CLIENT_ID=intellicare-portal
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_IN_PRODUCTION
KEYCLOAK_JWKS_CACHE_TTL=300
KEYCLOAK_TOKEN_CACHE_TTL=60
KEYCLOAK_VERIFY_SSL=true
KEYCLOAK_VALIDATE_AUDIENCE=true
KEYCLOAK_VALIDATE_ISSUER=true

# ============================================================================
# OPTIONAL MODULES - Nise (AI/LLM)
# ============================================================================
NISE_ENABLED=false
NISE_PORT=8008
NISE_DATABASE_URL=postgresql://intellicare_admin:CHANGE_ME_IN_PRODUCTION@postgres:5432/intellicare_db
NISE_REDIS_URL=redis://redis:6379/0
NISE_REDIS_TTL=300

# Flowise Integration
FLOWISE_URL=http://localhost:3000
FLOWISE_API_KEY=
FLOWISE_PASSWORD=admin123

# Ollama Integration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama2:7b

# ============================================================================
# OPTIONAL MODULES - Superz (Web Search)
# ============================================================================
SUPERZ_ENABLED=false
SUPERZ_PORT=8009
SUPERZ_WORKERS=2

# Tavily Web Search (Required for web_search tool)
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NCBI PubMed (Optional - improves rate limit)
NCBI_API_KEY=

# Superz LLM
SUPERZ_LLM_MODEL=qwen2.5:72b
SUPERZ_LLM_MODEL_FALLBACK=qwen2.5:7b
SUPERZ_TAVILY_RATE_LIMIT_PER_HOUR=100

# Knowledge Integration
SUPERZ_ENABLE_KNOWLEDGE_INTEGRATION=false
SUPERZ_KNOWLEDGE_BASE_URL=http://localhost:8010
SUPERZ_KNOWLEDGE_TIMEOUT_SECONDS=3.0

# ============================================================================
# CORE CONFIGURATION
# ============================================================================
INTELLICARE_ENVIRONMENT=development
INTELLICARE_LOG_LEVEL=INFO
INTELLICARE_MODULE_NAME=intellicare
INTELLICARE_MODULE_VERSION=0.1.0-demo

