{
  "dashboard": {
    "title": "IntelliCare - LGPD Compliance",
    "tags": ["intellicare", "comunicacao", "lgpd", "compliance"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "1m",
    "panels": [
      {
        "id": 1,
        "title": "Cobertura de Consentimento (%)",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
        "targets": [
          {
            "datasource": "PostgreSQL",
            "rawSql": "SELECT COUNT(CASE WHEN consent_given_at IS NOT NULL THEN 1 END)::float / COUNT(*)::float * 100 AS value FROM communication_preferences",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 70, "color": "yellow"},
                {"value": 90, "color": "green"}
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "title": "Comunicações por Base Legal (24h)",
        "type": "piechart",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "sum by(legal_basis)(increase(comm_lgpd_override_total[24h]))",
            "legendFormat": "{{legal_basis}}"
          }
        ]
      },
      {
        "id": 3,
        "title": "CRITICAL Overrides (24h)",
        "type": "stat",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "sum(increase(comm_lgpd_override_total{severity=\"CRITICAL\"}[24h]))",
            "legendFormat": "Total"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 50, "color": "yellow"},
                {"value": 100, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "title": "Bloqueados por LGPD (24h)",
        "type": "stat",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 6},
        "targets": [
          {
            "expr": "sum(increase(comm_lgpd_blocked_total[24h]))",
            "legendFormat": "Total"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {"mode": "thresholds"},
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 10, "color": "yellow"},
                {"value": 50, "color": "red"}
              ]
            }
          }
        }
      },
      {
        "id": 5,
        "title": "Overrides CRITICAL ao Longo do Tempo",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 6, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum(rate(comm_lgpd_override_total{severity=\"CRITICAL\"}[5m]))",
            "legendFormat": "CRITICAL overrides/s"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": {"drawStyle": "line", "lineInterpolation": "smooth"}
          }
        }
      },
      {
        "id": 6,
        "title": "Bloqueios por Motivo (24h)",
        "type": "bargauge",
        "gridPos": {"x": 12, "y": 6, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "sum by(reason)(increase(comm_lgpd_blocked_total[24h]))",
            "legendFormat": "{{reason}}"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      },
      {
        "id": 7,
        "title": "Integridade da Hash Chain de Auditoria",
        "type": "stat",
        "gridPos": {"x": 0, "y": 14, "w": 12, "h": 4},
        "targets": [
          {
            "expr": "comm_audit_chain_integrity",
            "legendFormat": "Integrity"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"type": "value", "value": 1, "text": "OK", "color": "green"},
              {"type": "value", "value": 0, "text": "BROKEN", "color": "red"}
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 1, "color": "green"}
              ]
            }
          }
        }
      }
    ]
  }
}

